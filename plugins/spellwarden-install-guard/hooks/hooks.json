{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(claude plugin install *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-install.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "if": "Bash(claude plugin marketplace add *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-install.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "if": "Bash(claude mcp add *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-install.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "if": "Bash(claude mcp add-json *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-install.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "if": "Bash(npx skills add *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-install.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "if": "Bash(gemini extensions install *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-install.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/.mcp.json)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-install.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "if": "Write(**/.mcp.json)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-install.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
